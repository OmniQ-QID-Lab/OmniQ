# Paper profile: the settings of the 59 published runs.
# `ra run --profile paper` sets each variable below only when it is not already in the environment.
# Per-task CPU and memory (PECE_NCPUS, PECE_MEM_GB) are in task_resources.tsv; the launcher passes them.
# Every other variable keeps its code default (docs/CONFIGURATION.md).
MODEL=deepseek/deepseek-v4.1-flash
WALLTIME_SEC=85800
RA3SR_VISION=1
RA3SR_RATES=0.15,0.003,0.60
RA_DSH_SHIM=1
