# Smoke profile: the shortened clocks the authors used to test a setup end to end (a 6-hour allocation), with the
# model, vision, rates and route of the paper profile.
# `ra run --profile smoke` sets each variable below only when it is not already in the environment.
MODEL=deepseek/deepseek-v4.1-flash
RA3SR_VISION=1
RA3SR_RATES=0.15,0.003,0.60
RA_DSH_SHIM=1
WALLTIME_SEC=21000
RA3_CP_S=1800
RA3_SCOUT_T=900
RA3_SCOUT_SELECT_T=600
RA3_MIN_ATTEMPT_S=3600
# Optional, as in the authors' smoke run: the first A/B audit is handled as a C, which exercises the scouting.
# Never set it in a scored run.
# RA3_SMOKE_FORCE_C=1
